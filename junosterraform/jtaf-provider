def render_template_and_write(input_template: str, output_file: str, context: dict, description: str):
    with open(input_template) as f:
        tmpl = Template(f.read())
    rendered = tmpl.render(data=context).lstrip()
    with open(output_file, "w") as f:
        f.write(rendered)
    print(f"Updated {description}")


def rewrite_import_prefixes(go_dir: str, old_prefix: str, new_prefix: str):
    """Replace module import prefixes across copied Go files in place."""
    for root, _, files in os.walk(go_dir):
        for filename in files:
            if not filename.endswith(".go"):
                continue
            full_path = os.path.join(root, filename)
            with open(full_path, "r", encoding="utf-8") as f:
                content = f.read()
            updated = content.replace(f'"{old_prefix}/', f'"{new_prefix}/')
            if updated != content:
                with open(full_path, "w", encoding="utf-8") as f:
                    f.write(updated)


def ensure_go_module_name(go_mod_path: str, module_name: str):
    """Ensure go.mod has the expected module directive."""
    with open(go_mod_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    updated = False
    for i, line in enumerate(lines):
        if line.startswith("module "):
            expected = f"module {module_name}\n"
            if line != expected:
                lines[i] = expected
                updated = True
            break

    if updated:
        with open(go_mod_path, "w", encoding="utf-8") as f:
            f.writelines(lines)


def _write_generic_main_go(new_dir, module_name, device_type):
    """Write main.go, which serves the generic provider for the embedded schema."""
    content = f"""package main

import (
\t"flag"
\t"log"

\t"{module_name}/generic"
)

// embeddedSchema is set by embed_schema.go.
var embeddedSchema []byte

func main() {{
\tdebug := flag.Bool("debug", false, "set to true to run the provider with support for debuggers like delve")
\tflag.Parse()
\tif err := generic.Serve("registry.terraform.io/juniper/junos-{device_type}", "junos-{device_type}", embeddedSchema, *debug); err != nil {{
\t\tlog.Fatal(err)
\t}}
}}
"""
    with open(os.path.join(new_dir, "main.go"), "w") as f:
        f.write(content)


def drop_version(resources):
    """Remove the top-level version leaf: it is the Junos release the
    configuration was last committed with, not configuration, and cannot be
    set. filter_json_using_xml drops it from a trimmed schema; a full model
    is not trimmed."""
    for root in resources.get("root", {}).get("children", []):
        if root.get("name") == "configuration":
            root["children"] = [c for c in root.get("children") or []
                                if c.get("name") != "version"]
    return resources


def exclude_schema_paths(resources, paths):
    """Remove the subtrees at paths (relative to configuration, e.g.
    "logical-systems" or "system/services/web-management") from the schema.
    A path that does not exist is an error, so a typo is not ignored."""
    config = next((c for c in resources["root"].get("children", [])
                   if c.get("name") == "configuration"), None)
    if config is None:
        raise ValueError("schema has no configuration node")
    for path in paths:
        parts = [p for p in path.strip("/").split("/") if p]
        if not parts:
            raise ValueError(f"--exclude {path!r}: empty path")
        node = config
        for part in parts[:-1]:
            node = next((c for c in node.get("children") or [] if c.get("name") == part), None)
            if node is None:
                raise ValueError(f"--exclude {path}: {part} not found")
        children = node.get("children") or []
        kept = [c for c in children if c.get("name") != parts[-1]]
        if len(kept) == len(children):
            raise ValueError(f"--exclude {path}: {parts[-1]} not found")
        node["children"] = kept
    return resources


def _flatten_choices(nodes):
    """Replace YANG choice and case nodes with their children, as the generic
    provider does (patch.FlattenChoices): a case's nodes appear directly under
    the choice's parent."""
    out = []
    for n in nodes or []:
        if n.get("type") in ("choice", "case"):
            out.extend(_flatten_choices(n.get("children")))
        else:
            out.append(n)
    return out


_VALID_ATTRIBUTE_NAME = re.compile(r"^[a-z_][a-z0-9_]*$")


def _attribute_name(name):
    """The generic provider's Terraform attribute name for a YANG node name
    (generic.SanitizeName)."""
    return name.replace("-", "_").replace(".", "_").lower()


def validate_attribute_names(resources):
    """Check that every configuration node's attribute name in the generic
    provider is valid and that no two siblings (with choices flattened) map to
    the same one, so the provider's schema cannot silently drop a node. The
    schema is fixed when the provider is generated, so it is checked here
    rather than each time the provider starts."""
    config = next((c for c in resources["root"].get("children", [])
                   if c.get("name") == "configuration"), None)
    if config is None:
        raise ValueError("schema has no configuration node")
    stack = [(config.get("children"), "configuration")]
    while stack:
        nodes, path = stack.pop()
        seen = {}
        for n in _flatten_choices(nodes):
            name = n.get("name")
            if not name:
                continue
            key = _attribute_name(name)
            if not _VALID_ATTRIBUTE_NAME.match(key):
                raise ValueError(f"{path}/{name}: {key!r} is not a valid attribute name")
            if key in seen:
                raise ValueError(f"{path}: {seen[key]} and {name} both map to attribute {key!r}")
            seen[key] = name
            stack.append((n.get("children"), f"{path}/{name}"))


def _compile_schema(new_dir, json_name, compiled_name):
    """Compile the schema into the form the provider embeds (patch.Schema's
    binary form), with the provider's own cmd/compileschema, so that the
    provider does not parse the JSON each time it starts."""
    try:
        subprocess.run(["go", "run", "./cmd/compileschema", json_name, compiled_name],
                       cwd=new_dir, check=True)
    except FileNotFoundError:
        sys.exit("jtaf-provider: --generic needs Go on PATH to compile the schema")
    except subprocess.CalledProcessError as e:
        sys.exit(f"jtaf-provider: compiling the schema failed ({e})")


def _generate_generic_provider(resources, device_type):
    """Copy generic provider source, and emit the schema and its compiled form."""
    with as_file(files('terraform_provider').joinpath('__init__.py')) as init_py:
        go_dir = os.path.dirname(init_py)

    new_dir = f"terraform-provider-junos-{device_type}"
    if os.path.exists(new_dir):
        shutil.rmtree(new_dir)

    def _ignore(directory, contents):
        ignored = set()
        if directory == go_dir:
            for item in contents:
                if item in ('tools', '__pycache__', 'coverage.html', 'coverage.out'):
                    ignored.add(item)
        # Skip test files in the output
        for item in contents:
            if item.endswith('_test.go'):
                ignored.add(item)
        return ignored

    shutil.copytree(go_dir, new_dir, ignore=_ignore)

    # Remove leftover build artifacts, and the main package of the generated
    # (Jinja2) provider: the generic provider's main package is main.go and
    # embed_schema.go, written below.
    for name in ('terraform_provider', '__init__.py'):
        p = os.path.join(new_dir, name)
        if os.path.exists(p):
            os.remove(p)
    for name in os.listdir(new_dir):
        if name.endswith('.go'):
            os.remove(os.path.join(new_dir, name))

    # Write trimmed_schema.json.gz, compact and compressed (a full model is
    # hundreds of MB as indented JSON); it is compiled into schema.bin.gz below.
    schema_path = os.path.join(new_dir, "trimmed_schema.json.gz")
    write_schema_json_gz(resources, schema_path)
    print(f"Schema written to {os.path.relpath(schema_path)}")

    # Generate embed_schema.go, which embeds the compiled schema via go:embed
    embed_go = os.path.join(new_dir, "embed_schema.go")
    with open(embed_go, "w") as f:
        f.write('package main\n\nimport _ "embed"\n\n')
        f.write('//go:embed schema.bin.gz\n')
        f.write('var compiledSchemaBytes []byte\n\n')
        f.write('func init() { embeddedSchema = compiledSchemaBytes }\n')
    print(f"Created {os.path.relpath(embed_go)}")

    expected_module = f"terraform-provider-junos-{device_type}"

    # go.mod and go.sum are the provider module's own, copied above; only the
    # module name changes.
    _write_generic_main_go(new_dir, expected_module, device_type)
    print("Created main.go with type junos-" + device_type)

    ensure_go_module_name(os.path.join(new_dir, "go.mod"), expected_module)
    print(f"Updated go.mod with type junos-{device_type}")
    rewrite_import_prefixes(new_dir, "terraform_provider", expected_module)

    _compile_schema(new_dir, "trimmed_schema.json.gz", "schema.bin.gz")
    print(f"Compiled schema written to {os.path.join(new_dir, 'schema.bin.gz')}")

    print(f"\nGeneric provider created in {new_dir}/")
    print(f"Build with: cd {new_dir} && go build .")


# Main Method
def main():
    # other arguments
    parser = argparse.ArgumentParser(
        description='Generate a Terraform provider from JTAF JSON and XML config.',
        exit_on_error=True,
    )
    parser.add_argument(
        '-j',
        '--json-schema',
        required=True,
        help="Path to the JTAF JSON schema from pyang, plain or gzipped "
             "(e.g. trimmed_schema.json.gz), or '-' to read it from stdin.",
    )
    parser.add_argument(
        '-x',
        '--xml-config',
        required=False,
        action='append',
        nargs="+",
        help='Optional Junos XML config files to merge/filter against schema.',
    )
    parser.add_argument(
        '-t',
        '--type',
        required=True,
        help='Device type suffix used in output directory name.',
    )
    parser.add_argument(
        '--generic',
        action='store_true',
        default=False,
        help='Use generic schema-driven provider instead of Jinja2 code generation.',
    )
    parser.add_argument(
        '--exclude',
        action='append',
        default=[],
        metavar='PATH',
        help='Leave the schema subtree at PATH (relative to configuration, e.g. '
             'logical-systems or system/services/web-management) out of the '
             'provider. Repeatable.',
    )
    args = parser.parse_args()

    # Step 1: Filter the schema only when XML config is supplied.
    # Without -x, keep the schema as a direct copy of pyang JSON output.
    if args.xml_config:
        xml_files = [file for group in args.xml_config for file in group]
        xml_config = xml_files[0] if len(xml_files) == 1 else load_and_merge_xmls(xml_files)
        resources = filter_json_using_xml(args.json_schema, xml_config)
    else:
        resources = load_schema_json(args.json_schema)

    if args.exclude:
        try:
            resources = exclude_schema_paths(resources, args.exclude)
        except ValueError as e:
            parser.error(str(e))
    drop_version(resources)

    # Step 2: Either use generic provider or Jinja2 template
    if args.generic:
        try:
            validate_attribute_names(resources)
        except ValueError as e:
            sys.exit(f"jtaf-provider: {e}")
        _generate_generic_provider(resources, args.type)
        return

    # Step 2 (legacy): Render the template into Go code
    with as_file(files('junosterraform').joinpath('__init__.py')) as init_py:
        package_dir = os.path.dirname(init_py)
    templates_dir = f"{package_dir}/templates"
    with open(f"{templates_dir}/resource_config_provider.go.j2") as f:
        jinja2_source = f.read()
    tmpl = Template(jinja2_source)
    render_context = dict(resources)
    render_context["device_type"] = args.type
    resource_config_provider_go = tmpl.render(data=render_context).lstrip()

    # Step 3: Prepare new output directory based on type
    with as_file(files('terraform_provider').joinpath('__init__.py')) as init_py:
        go_dir = os.path.dirname(init_py)
    new_dir = f"terraform-provider-junos-{args.type}"

    # Step 4: copy the template go files into place
    if os.path.exists(new_dir):
        shutil.rmtree(new_dir)
    # Exclude directories that should not be in generated providers
    def _ignore_dirs(directory, contents):
        ignored = set()
        if directory == go_dir:
            for item in contents:
                if item in ('tools', '__pycache__'):
                    ignored.add(item)
        return ignored
    shutil.copytree(go_dir, new_dir, ignore=_ignore_dirs)
    # if there is a terraform_provider executable left over from go testing, remove it
    tp_exe = f"{new_dir}/terraform_provider"
    if os.path.exists(tp_exe):
        os.remove(tp_exe)

    # Step 5: Save rendered Go file into new directory
    resource_config_provider_go_fullpath = os.path.join(new_dir, "resource_config_provider.go")
    with open(resource_config_provider_go_fullpath, "w") as f:
        f.write(resource_config_provider_go)
    print(f"Plugin created in {os.path.relpath(resource_config_provider_go_fullpath)}\n")

    # Step 6-7: Update provider.go and config.go with correct type using a loop
    files_to_update = [
        ("provider.go.j2", "provider.go"),
        ("config.go.j2", "config.go"),
    ]
    for template_name, output_name in files_to_update:
        with open(f"{templates_dir}/{template_name}") as f:
            jinja2_source = f.read()
        tmpl = Template(jinja2_source)
        rendered = tmpl.render(data={"device_type": args.type}).lstrip()
        output_path = os.path.join(new_dir, output_name)
        with open(output_path, "w") as f:
            f.write(rendered)
        print(f"Updated {output_name} with type junos-{args.type}")

    # Step 8: go.mod and go.sum are the provider module's own, copied with the
    # sources, so they match what the module is built and tested with; only the
    # module name changes.
    expected_module = f"terraform-provider-junos-{args.type}"
    go_mod_path = os.path.join(new_dir, "go.mod")
    ensure_go_module_name(go_mod_path, expected_module)
    print(f"Updated go.mod with type junos-{args.type}")

    # Step 8: Normalize import prefixes in copied Go files (including tests).
    rewrite_import_prefixes(new_dir, "terraform_provider", expected_module)

    # Step 7: Add trimmed_schema.json.gz to new directory, for the downstream
    # tools (jtaf-xml2tf); the provider itself inlines the schema in Go source.
    schema_path = os.path.join(new_dir, "trimmed_schema.json.gz")
    write_schema_json_gz(resources, schema_path)
    print(f"Schema written to {os.path.relpath(schema_path)}")

# run main()
if __name__ == "__main__":
    main()
