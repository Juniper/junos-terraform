def render_template_and_write(input_template: str, output_file: str, context: dict, description: str):
    with open(input_template) as f:
        tmpl = Template(f.read())
    rendered = tmpl.render(data=context).lstrip()
    with open(output_file, "w") as f:
        f.write(rendered)
    print(f"Updated {description}")


def rewrite_import_prefixes(go_dir: str, old_prefix: str, new_prefix: str):
    """Replace module import prefixes across copied Go files in place."""
    for root, _, files in os.walk(go_dir):
        for filename in files:
            if not filename.endswith(".go"):
                continue
            full_path = os.path.join(root, filename)
            with open(full_path, "r", encoding="utf-8") as f:
                content = f.read()
            updated = content.replace(f'"{old_prefix}/', f'"{new_prefix}/')
            if updated != content:
                with open(full_path, "w", encoding="utf-8") as f:
                    f.write(updated)


def ensure_go_module_name(go_mod_path: str, module_name: str):
    """Ensure go.mod has the expected module directive."""
    with open(go_mod_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    updated = False
    for i, line in enumerate(lines):
        if line.startswith("module "):
            expected = f"module {module_name}\n"
            if line != expected:
                lines[i] = expected
                updated = True
            break

    if updated:
        with open(go_mod_path, "w", encoding="utf-8") as f:
            f.writelines(lines)


def _write_generic_provider_go(new_dir, module_name, device_type):
    """Write provider.go with generic resource registration."""
    content = f'''package main

import (
\t"context"

\t"{module_name}/generic"
\t"{module_name}/netconf"

\t"github.com/hashicorp/terraform-plugin-framework/datasource"
\t"github.com/hashicorp/terraform-plugin-framework/provider"
\t"github.com/hashicorp/terraform-plugin-framework/provider/schema"
\t"github.com/hashicorp/terraform-plugin-framework/resource"
\t"github.com/hashicorp/terraform-plugin-framework/types"
)

var _ provider.Provider = new(Provider)

var providerClientFactory = func(cfg *Config) (netconf.Client, error) {{
\treturn cfg.Client()
}}

func newProvider() provider.Provider {{
\treturn Provider{{}}
}}

type Provider struct {{
}}

type providerModel struct {{
\tHost     types.String `tfsdk:"host"`
\tUsername types.String `tfsdk:"username"`
\tPassword types.String `tfsdk:"password"`
\tPort     types.Int64  `tfsdk:"port"`
\tSshKey   types.String `tfsdk:"sshkey"`
}}

type ProviderConfig struct {{
\tnetconf.Client
\tHost string
}}

func (p ProviderConfig) GetClient() netconf.Client {{ return p.Client }}
func (p ProviderConfig) GetHost() string           {{ return p.Host }}

func buildProviderConfig(config providerModel) (ProviderConfig, error) {{
\tclientConfig := Config{{
\t\tHost:     config.Host.ValueString(),
\t\tPort:     int(config.Port.ValueInt64()),
\t\tUsername: config.Username.ValueString(),
\t\tPassword: config.Password.ValueString(),
\t\tSSHKey:   config.SshKey.ValueString(),
\t}}
\tclient, err := providerClientFactory(&clientConfig)
\tif err != nil {{
\t\treturn ProviderConfig{{}}, err
\t}}
\treturn ProviderConfig{{Client: client, Host: clientConfig.Host}}, nil
}}

func (p Provider) Configure(ctx context.Context, req provider.ConfigureRequest, resp *provider.ConfigureResponse) {{
\tvar config providerModel
\tresp.Diagnostics.Append(req.Config.Get(ctx, &config)...)
\tif resp.Diagnostics.HasError() {{
\t\treturn
\t}}
\tproviderConfig, err := buildProviderConfig(config)
\tif err != nil {{
\t\tresp.Diagnostics.AddError("failed to create client", err.Error())
\t\treturn
\t}}
\tresp.ResourceData = providerConfig
}}

func (p Provider) DataSources(_ context.Context) []func() datasource.DataSource {{
\treturn nil
}}

func (p Provider) Metadata(_ context.Context, _ provider.MetadataRequest, resp *provider.MetadataResponse) {{
\tresp.TypeName = "junos-{device_type}"
}}

// embeddedSchema is set by embed_schema.go init().
var embeddedSchema []byte

func (p Provider) Resources(_ context.Context) []func() resource.Resource {{
\tif embeddedSchema == nil {{
\t\treturn nil
\t}}
\tidx, nodes, err := generic.LoadSchema(embeddedSchema)
\tif err != nil {{
\t\treturn nil
\t}}
\treturn []func() resource.Resource{{
\t\tfunc() resource.Resource {{
\t\t\treturn generic.NewConfigResource(idx, nodes, string(embeddedSchema))
\t\t}},
\t}}
}}

func (p Provider) Schema(_ context.Context, _ provider.SchemaRequest, resp *provider.SchemaResponse) {{
\tresp.Schema = schema.Schema{{
\t\tAttributes: map[string]schema.Attribute{{
\t\t\t"host":     schema.StringAttribute{{Required: true}},
\t\t\t"username": schema.StringAttribute{{Required: true}},
\t\t\t"password": schema.StringAttribute{{Optional: true, Sensitive: true}},
\t\t\t"port":     schema.Int64Attribute{{Required: true}},
\t\t\t"sshkey":   schema.StringAttribute{{Optional: true, Sensitive: true}},
\t\t}},
\t}}
}}
'''
    with open(os.path.join(new_dir, "provider.go"), "w") as f:
        f.write(content)


def _generate_generic_provider(resources, device_type):
    """Copy generic provider source and emit trimmed_schema.json."""
    with as_file(files('terraform_provider').joinpath('__init__.py')) as init_py:
        go_dir = os.path.dirname(init_py)

    new_dir = f"terraform-provider-junos-{device_type}"
    if os.path.exists(new_dir):
        shutil.rmtree(new_dir)

    def _ignore(directory, contents):
        ignored = set()
        if directory == go_dir:
            for item in contents:
                if item in ('tools', '__pycache__', 'coverage.html', 'coverage.out'):
                    ignored.add(item)
        # Skip test files in the output
        for item in contents:
            if item.endswith('_test.go'):
                ignored.add(item)
        return ignored

    shutil.copytree(go_dir, new_dir, ignore=_ignore)

    # Remove leftover build artifacts
    for name in ('terraform_provider', '__init__.py'):
        p = os.path.join(new_dir, name)
        if os.path.exists(p):
            os.remove(p)

    # Write trimmed_schema.json
    schema_path = os.path.join(new_dir, "trimmed_schema.json")
    with open(schema_path, "w") as f:
        json.dump(resources, f, indent=2)
    print(f"Schema written to {os.path.relpath(schema_path)}")

    # Generate embed_schema.go that loads the JSON via go:embed
    embed_go = os.path.join(new_dir, "embed_schema.go")
    with open(embed_go, "w") as f:
        f.write('package main\n\nimport _ "embed"\n\n')
        f.write('//go:embed trimmed_schema.json\n')
        f.write('var trimmedSchemaBytes []byte\n\n')
        f.write('func init() { embeddedSchema = trimmedSchemaBytes }\n')
    print(f"Created {os.path.relpath(embed_go)}")

    expected_module = f"terraform-provider-junos-{device_type}"

    # Render go.mod and config.go from templates; write provider.go directly for generic mode.
    with as_file(files('junosterraform').joinpath('__init__.py')) as init_py:
        templates_dir = os.path.join(os.path.dirname(init_py), "templates")

    from jinja2 import Template
    for template_name, output_name in [("go.mod.j2", "go.mod"),
                                        ("config.go.j2", "config.go")]:
        with open(f"{templates_dir}/{template_name}") as tf:
            tmpl = Template(tf.read())
        rendered = tmpl.render(data={"device_type": device_type}).lstrip()
        with open(os.path.join(new_dir, output_name), "w") as of:
            of.write(rendered)
        print(f"Updated {output_name} with type junos-{device_type}")

    # Write provider.go with generic resource registration
    _write_generic_provider_go(new_dir, expected_module, device_type)
    print("Updated provider.go with type junos-" + device_type)

    ensure_go_module_name(os.path.join(new_dir, "go.mod"), expected_module)
    rewrite_import_prefixes(new_dir, "terraform_provider", expected_module)

    # Remove the Jinja2-generated stub resource_config_provider.go (generic/ replaces it)
    stub = os.path.join(new_dir, "resource_config_provider.go")
    if os.path.exists(stub):
        os.remove(stub)

    print(f"\nGeneric provider created in {new_dir}/")
    print(f"Build with: cd {new_dir} && go build .")


# Main Method
def main():
    # other arguments
    parser = argparse.ArgumentParser(
        description='Generate a Terraform provider from JTAF JSON and XML config.',
        exit_on_error=True,
    )
    parser.add_argument(
        '-j',
        '--json-schema',
        required=True,
        help="Path to JTAF JSON schema, or '-' to read JSON from stdin.",
    )
    parser.add_argument(
        '-x',
        '--xml-config',
        required=False,
        action='append',
        nargs="+",
        help='Optional Junos XML config files to merge/filter against schema.',
    )
    parser.add_argument(
        '-t',
        '--type',
        required=True,
        help='Device type suffix used in output directory name.',
    )
    parser.add_argument(
        '--generic',
        action='store_true',
        default=False,
        help='Use generic schema-driven provider instead of Jinja2 code generation.',
    )
    args = parser.parse_args()

    # Step 1: Filter the schema only when XML config is supplied.
    # Without -x, keep trimmed_schema.json as a direct copy of pyang JSON output.
    if args.xml_config:
        xml_files = [file for group in args.xml_config for file in group]
        xml_config = xml_files[0] if len(xml_files) == 1 else load_and_merge_xmls(xml_files)
        resources = filter_json_using_xml(args.json_schema, xml_config)
    else:
        if args.json_schema == "-":
            resources = json.load(sys.stdin)
        else:
            with open(args.json_schema) as f:
                resources = json.load(f)

    # Step 2: Either use generic provider or Jinja2 template
    if args.generic:
        _generate_generic_provider(resources, args.type)
        return

    # Step 2 (legacy): Render the template into Go code
    with as_file(files('junosterraform').joinpath('__init__.py')) as init_py:
        package_dir = os.path.dirname(init_py)
    templates_dir = f"{package_dir}/templates"
    with open(f"{templates_dir}/resource_config_provider.go.j2") as f:
        jinja2_source = f.read()
    tmpl = Template(jinja2_source)
    render_context = dict(resources)
    render_context["device_type"] = args.type
    resource_config_provider_go = tmpl.render(data=render_context).lstrip()

    # Step 3: Prepare new output directory based on type
    with as_file(files('terraform_provider').joinpath('__init__.py')) as init_py:
        go_dir = os.path.dirname(init_py)
    new_dir = f"terraform-provider-junos-{args.type}"

    # Step 4: copy the template go files into place
    if os.path.exists(new_dir):
        shutil.rmtree(new_dir)
    # Exclude directories that should not be in generated providers
    def _ignore_dirs(directory, contents):
        ignored = set()
        if directory == go_dir:
            for item in contents:
                if item in ('tools', '__pycache__'):
                    ignored.add(item)
        return ignored
    shutil.copytree(go_dir, new_dir, ignore=_ignore_dirs)
    # if there is a terraform_provider executable left over from go testing, remove it
    tp_exe = f"{new_dir}/terraform_provider"
    if os.path.exists(tp_exe):
        os.remove(tp_exe)

    # Step 5: Save rendered Go file into new directory
    resource_config_provider_go_fullpath = os.path.join(new_dir, "resource_config_provider.go")
    with open(resource_config_provider_go_fullpath, "w") as f:
        f.write(resource_config_provider_go)
    print(f"Plugin created in {os.path.relpath(resource_config_provider_go_fullpath)}\n")

    # Step 6-8: Update provider.go, go.mod, and config.go with correct type using a loop
    files_to_update = [
        ("provider.go.j2", "provider.go"),
        ("go.mod.j2", "go.mod"),
        ("config.go.j2", "config.go"),
    ]
    for template_name, output_name in files_to_update:
        with open(f"{templates_dir}/{template_name}") as f:
            jinja2_source = f.read()
        tmpl = Template(jinja2_source)
        rendered = tmpl.render(data={"device_type": args.type}).lstrip()
        output_path = os.path.join(new_dir, output_name)
        with open(output_path, "w") as f:
            f.write(rendered)
        print(f"Updated {output_name} with type junos-{args.type}")

    expected_module = f"terraform-provider-junos-{args.type}"
    go_mod_path = os.path.join(new_dir, "go.mod")
    ensure_go_module_name(go_mod_path, expected_module)

    # Step 8: Normalize import prefixes in copied Go files (including tests).
    rewrite_import_prefixes(new_dir, "terraform_provider", expected_module)

    # Step 7: Add trimmed_schema.json to new directory
    trimmed_schema_path = os.path.join(new_dir, "trimmed_schema.json")
    with open(trimmed_schema_path, "w") as f:
        json.dump(resources, f, indent=2)

# run main()
if __name__ == "__main__":
    main()
