#!/usr/bin/env python3
import argparse
import os
from importlib.resources import as_file, files

from jinja2 import Template

from junosterraform.jtaf_common import (
    filter_json_using_xml,
    load_and_merge_xmls,
    write_schema_json_gz,
)


def main() -> None:
    """Generate an Ansible role/playbook from JTAF JSON schema and XML configuration.

    Parses command-line arguments for JSON schema (pyang output) and XML config files,
    filters schema to match config XPaths, renders Jinja2 templates, and generates a
    complete Ansible role structure with hierarchical variable merging support.

    Output directory structure:
        ansible-provider-junos-<type>/
            roles/<type>_role/
                tasks/main.yml
                templates/template.j2
            filter_plugins/
            group_vars/
            host_vars/
            configs/
            jtaf-playbook.yml
            trimmed_schema.json.gz
    """
    # other arguments
    parser = argparse.ArgumentParser(
        description='Generate an Ansible role/playbook from JTAF JSON and XML config.',
        exit_on_error=True,
    )
    parser.add_argument(
        '-j',
        '--json-schema',
        required=True,
        help="Path to the JTAF JSON schema from pyang, plain or gzipped "
             "(e.g. trimmed_schema.json.gz), or '-' to read it from stdin.",
    )
    parser.add_argument(
        '-x',
        '--xml-config',
        required=True,
        action='append',
        nargs="+",
        help='One or more Junos XML config files to merge/filter against schema.',
    )
    parser.add_argument(
        '-t',
        '--type',
        required=True,
        help='Device type suffix used in output directory name.',
    )
    parser.add_argument(
        '--mode',
        choices=['group', 'override'],
        default='group',
        help='Operating mode: "group" wraps config in apply-groups (default), "override" renders bare <configuration> for load override.',
    )
    args = parser.parse_args()

    # Merge XML files if multiple are provided.
    xml_files = [file for group in args.xml_config for file in group]
    xml_config = xml_files[0] if len(xml_files) == 1 else load_and_merge_xmls(xml_files)

    # Step 1: Filter the schema using the config
    resources = filter_json_using_xml(args.json_schema, xml_config)

    # Step 2: Render the template into Jinja2 code
    with as_file(files('junosterraform').joinpath('__init__.py')) as init_py:
        package_dir = os.path.dirname(init_py)
    templates_dir = f"{package_dir}/templates"
    with open(f"{templates_dir}/ansible.j2") as f:
        jinja2_source = f.read()
    tmpl = Template(jinja2_source)
    rendered_lines = tmpl.render(data=resources, jtaf_mode=args.mode).splitlines()
    resource_config_provider_j2 = "\n".join(
        line for line in rendered_lines if line.strip()
    )

    # Step 3: Prepare new output directory based on type
    new_dir = f"ansible-provider-junos-{args.type}"

    # Create roles/<rolename>/{tasks,templates} structure.
    role_name = f"{args.type}_role"
    roles_path = os.path.join(new_dir, "roles", role_name)
    tasks_path = os.path.join(roles_path, "tasks")
    templates_path = os.path.join(roles_path, "templates")
    defaults_path = os.path.join(roles_path, "defaults")
    os.makedirs(tasks_path, exist_ok=True)
    os.makedirs(templates_path, exist_ok=True)
    os.makedirs(defaults_path, exist_ok=True)
    os.makedirs(os.path.join(new_dir, "host_vars"), exist_ok=True)
    os.makedirs(os.path.join(new_dir, "group_vars"), exist_ok=True)
    os.makedirs(os.path.join(new_dir, "configs"), exist_ok=True)

    # write role defaults/main.yml with mode and commit confirm settings
    defaults_main = f"""---
# JTAF operating mode: "group" (default) or "override"
#   group    - wraps config in <groups>JTAF_ANSIBLE</groups>, pushes with load replace
#   override - renders bare <configuration>, pushes with load override + commit confirmed
jtaf_mode: "{args.mode}"

# Commit confirmed timeout in minutes (override mode only).
# If the device becomes unreachable after override, Junos auto-rolls back after this timer.
jtaf_commit_confirm_minutes: 2

# Group name used in group mode (ignored in override mode).
jtaf_group_name: "JTAF_ANSIBLE"
"""
    with open(os.path.join(defaults_path, "main.yml"), "w") as f:
        f.write(defaults_main)

    # write a merge-aware tasks/main.yml
    tasks_main = """---
# Hierarchical variable merging.
# Merge order: group_vars/all.yml -> group_vars/<type>/all.yml -> host_vars/<host>.yml
# with optional _merge_directive meta-instructions for custom behavior.

# Load the canonical variable hierarchy directly in the role so no pre_tasks are needed.
- name: Initialize explicit variable layers
  set_fact:
    jtaf_group_all: {{}}
    jtaf_group_merged: {{}}
    jtaf_host_vars: {{}}
  tags: [load_vars]

- name: Load global group vars
  set_fact:
    jtaf_group_all: "{{{{ lookup('file', jtaf_group_all_file) | from_yaml }}}}"
  vars:
    jtaf_group_all_file: "{{{{ jtaf_vars_root }}}}/group_vars/all.yaml"
  when: (query('ansible.builtin.fileglob', jtaf_group_all_file) | length) > 0
  tags: [load_vars]

- name: Merge group vars for each inventory group
  set_fact:
    jtaf_group_merged: "{{{{ jtaf_group_merged | combine(lookup('file', jtaf_group_file) | from_yaml, recursive=True, list_merge='append') }}}}"
  vars:
    jtaf_group_file: "{{{{ jtaf_vars_root }}}}/group_vars/{{{{ item }}}}/all.yaml"
  loop: "{{{{ group_names }}}}"
  when: (query('ansible.builtin.fileglob', jtaf_group_file) | length) > 0
  tags: [load_vars]

- name: Locate host vars file
  set_fact:
    jtaf_host_file: "{{{{ (query('ansible.builtin.fileglob', jtaf_vars_root + '/host_vars/' + inventory_hostname + '.y*ml') | sort | first) | default('', true) }}}}"
  tags: [load_vars]

- name: Load host vars
  set_fact:
    jtaf_host_vars: "{{{{ lookup('file', jtaf_host_file) | from_yaml }}}}"
  when: jtaf_host_file | length > 0
  tags: [load_vars]

# Build jtaf_effective from the loaded hierarchy layers.
- name: Merge variables from hierarchy
  set_fact:
    jtaf_effective: >-
      {{{{
        jtaf_group_all | combine(jtaf_group_merged, recursive=True, list_merge='append')
        | combine(jtaf_host_vars, recursive=True, list_merge='append')
      }}}}
  tags: [merge_vars]

# Handle _merge_directive meta-instructions for custom merge behavior
- name: Apply custom merge directives
  set_fact:
    jtaf_effective: "{{{{ jtaf_effective | jtaf_apply_merge_directives | jtaf_remove_meta }}}}"
  when: jtaf_effective is defined
  tags: [merge_directives]

- name: Applying template for {role_name}
  template: src=template.j2 dest={{{{ tmp_dir }}}}/{{{{ inventory_hostname }}}}.xml
""".format(role_name=role_name)
    with open(os.path.join(tasks_path, "main.yml"), "w") as f:
        f.write(tasks_main)

    # write group_vars/all.yml — common defaults shared by all hosts
    group_vars_all = """# Common configuration for all hosts managed by this JTAF Ansible role.
# Values here are overridden by group_vars/<type>/all.yml, then host_vars/<host>.yml.
# No JTAF-specific wrapper containers are required.
"""
    with open(os.path.join(new_dir, "group_vars", "all.yml"), "w") as f:
        f.write(group_vars_all)

    # generate filter_plugins/jtaf_filters.py so the role's merge directives work
    filter_plugins_path = os.path.join(new_dir, "filter_plugins")
    os.makedirs(filter_plugins_path, exist_ok=True)
    with as_file(files('junosterraform').joinpath('templates/jtaf_filters.py')) as filters_src:
        with open(filters_src) as f:
            filters_content = f.read()
    with open(os.path.join(filter_plugins_path, "jtaf_filters.py"), "w") as f:
        f.write(filters_content)

    # copy rendered main.j2 into the role templates as an example
    with open(os.path.join(templates_path, "template.j2"), "w") as f:
        f.write(resource_config_provider_j2)

    # Step 4: Create ansible playbook with pre_tasks for loading canonical hierarchy
    playbook_content = f"""- name: Apply Junos configuration
  hosts: all
  connection: local
  gather_facts: no
  vars:
    tmp_dir: "configs"
    jtaf_vars_root: "{{{{ playbook_dir }}}}/../ansible_files"
  roles:
    - role: {role_name}
      delegate_to: localhost

- name: Push configuration to devices
  hosts: all
  connection: local
  gather_facts: no
  vars:
    netconf_user: "{{{{ lookup('env', 'NETCONF_USERNAME') }}}}"
    netconf_pass: "{{{{ lookup('env', 'NETCONF_PASSWORD') }}}}"
    tmp_dir: "configs"
  tasks:
    - name: Push config (override mode)
      juniper.device.config:
        host: "{{{{ ansible_host | default(inventory_hostname) }}}}"
        port: "{{{{ ansible_port | default(830) }}}}"
        user: "{{{{ netconf_user }}}}"
        passwd: "{{{{ netconf_pass }}}}"
        load: override
        src: "{{{{ tmp_dir }}}}/{{{{ inventory_hostname }}}}.xml"
        confirmed: "{{{{ jtaf_commit_confirm_minutes | default(2) }}}}"
        diff: true
      register: override_result
      when: jtaf_mode | default('group') == 'override'

    - name: Push config (group mode)
      juniper.device.config:
        host: "{{{{ ansible_host | default(inventory_hostname) }}}}"
        port: "{{{{ ansible_port | default(830) }}}}"
        user: "{{{{ netconf_user }}}}"
        passwd: "{{{{ netconf_pass }}}}"
        load: replace
        src: "{{{{ tmp_dir }}}}/{{{{ inventory_hostname }}}}.xml"
        confirmed: "{{{{ jtaf_commit_confirm_minutes | default(5) }}}}"
        check_commit_wait: 5
        diff: true
        comment: "Apply config generated by JTAF"
      register: group_result
      when: jtaf_mode | default('group') == 'group'

    - name: Verify device reachability (override mode)
      wait_for:
        host: "{{{{ ansible_host | default(inventory_hostname) }}}}"
        port: "{{{{ ansible_port | default(830) }}}}"
        timeout: "{{{{ (jtaf_commit_confirm_minutes | default(2)) * 60 - 10 }}}}"
      when: jtaf_mode | default('group') == 'override'

    - name: Confirm commit (override mode)
      juniper.device.config:
        host: "{{{{ ansible_host | default(inventory_hostname) }}}}"
        port: "{{{{ ansible_port | default(830) }}}}"
        user: "{{{{ netconf_user }}}}"
        passwd: "{{{{ netconf_pass }}}}"
        check: true
        diff: false
        commit: false
      when: jtaf_mode | default('group') == 'override'

    - name: Confirm commit (group mode)
      juniper.device.config:
        host: "{{{{ ansible_host | default(inventory_hostname) }}}}"
        port: "{{{{ ansible_port | default(830) }}}}"
        user: "{{{{ netconf_user }}}}"
        passwd: "{{{{ netconf_pass }}}}"
        check: true
        diff: false
        commit: false
      when: jtaf_mode | default('group') == 'group'
"""
    with open(os.path.join(new_dir, "jtaf-playbook.yml"), "w") as f:
        f.write(playbook_content)

    # Step 5: Add trimmed_schema.json.gz to new directory, for jtaf-xml2yaml
    write_schema_json_gz(resources, os.path.join(new_dir, "trimmed_schema.json.gz"))


if __name__ == "__main__":
    main()
